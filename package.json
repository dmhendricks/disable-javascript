{
    "name": "disable-javascript",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "Browser extension that allows you to toggle JavaScript on a per-site basis",
    "license": "MIT",
    "scripts": {
        "dev": "vite build --watch --mode development",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "icons": "node scripts/render-icons.mjs"
    },
    "overrides": {
        "rollup": "^4.60.0"
    },
    "allowScripts": {
        "@parcel/watcher": true,
        "fsevents": true,
        "esbuild": true
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.7.1",
        "@eslint/js": "^10.0.1",
        "@resvg/resvg-js": "^2.6.2",
        "@types/chrome": "^0.3.0",
        "@types/node": "^26.6.2",
        "eslint": "^10.11.0",
        "eslint-plugin-unicorn": "^76.0.0",
        "globals": "^17.9.0",
        "prettier": "^3.9.5",
        "sass": "^1.102.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.66.0",
        "vite": "^8.2.0",
        "vitest": "^5.0.1"
    }
}
